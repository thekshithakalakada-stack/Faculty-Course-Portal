<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <!-- =============================================================== -->
    <!-- APPLICATION METADATA & CONFIGURATION                            -->
    <!-- Syllabus Demonstration: Deployment Descriptor (web.xml)         -->
    <!-- =============================================================== -->
    <display-name>Faculty Course Management Portal</display-name>
    <description>
        College Web Technologies Portal demonstrating Servlets, JDBC, MVC, Sessions, and Cookies.
    </description>

    <!-- Context Initialization Parameters (Application Scope) -->
    <context-param>
        <param-name>institutionName</param-name>
        <param-value>Department of Computer Science &amp; Engineering</param-value>
    </context-param>

    <!-- =============================================================== -->
    <!-- 1. LOGIN SERVLET CONFIGURATION                                  -->
    <!-- Demonstrates: servlet, init-param, and servlet-mapping           -->
    <!-- =============================================================== -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.portal.controller.LoginServlet</servlet-class>
        <!-- Servlet Initialization Parameters (Retrieved via ServletConfig) -->
        <init-param>
            <param-name>applicationName</param-name>
            <param-value>Faculty Course Management Portal</param-value>
        </init-param>
        <init-param>
            <param-name>adminContact</param-name>
            <param-value>admin@college.edu</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- =============================================================== -->
    <!-- 2. LOGOUT SERVLET CONFIGURATION                                 -->
    <!-- =============================================================== -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.portal.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- =============================================================== -->
    <!-- 3. VIEW COURSES SERVLET CONFIGURATION                           -->
    <!-- =============================================================== -->
    <servlet>
        <servlet-name>CourseServlet</servlet-name>
        <servlet-class>com.portal.controller.CourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CourseServlet</servlet-name>
        <url-pattern>/courses</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CourseServlet</servlet-name>
        <url-pattern>/viewCourses</url-pattern>
    </servlet-mapping>

    <!-- =============================================================== -->
    <!-- 4. ADD COURSE SERVLET CONFIGURATION                             -->
    <!-- =============================================================== -->
    <servlet>
        <servlet-name>AddCourseServlet</servlet-name>
        <servlet-class>com.portal.controller.AddCourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddCourseServlet</servlet-name>
        <url-pattern>/addCourse</url-pattern>
    </servlet-mapping>

    <!-- =============================================================== -->
    <!-- 5. UPDATE COURSE SERVLET CONFIGURATION                          -->
    <!-- =============================================================== -->
    <servlet>
        <servlet-name>UpdateCourseServlet</servlet-name>
        <servlet-class>com.portal.controller.UpdateCourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateCourseServlet</servlet-name>
        <url-pattern>/updateCourse</url-pattern>
    </servlet-mapping>

    <!-- =============================================================== -->
    <!-- 6. DELETE COURSE SERVLET CONFIGURATION                          -->
    <!-- =============================================================== -->
    <servlet>
        <servlet-name>DeleteCourseServlet</servlet-name>
        <servlet-class>com.portal.controller.DeleteCourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteCourseServlet</servlet-name>
        <url-pattern>/deleteCourse</url-pattern>
    </servlet-mapping>

    <!-- =============================================================== -->
    <!-- 7. EDIT COURSE SERVLET CONFIGURATION                            -->
    <!-- =============================================================== -->
    <servlet>
        <servlet-name>EditCourseServlet</servlet-name>
        <servlet-class>com.portal.controller.EditCourseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EditCourseServlet</servlet-name>
        <url-pattern>/editCourse</url-pattern>
    </servlet-mapping>

    <!-- =============================================================== -->
    <!-- SESSION TIMEOUT CONFIGURATION                                   -->
    <!-- Inactivity timeout in minutes                                   -->
    <!-- =============================================================== -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- =============================================================== -->
    <!-- WELCOME FILE LIST                                               -->
    <!-- =============================================================== -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
